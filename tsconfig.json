{
  "compilerOptions": {
    "rootDir": "src",

    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2025",
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "isolatedDeclarations": true,
    "declaration": true,
    "lib": ["ES2025", "DOM", "ESNext.Disposable"],
    // Don't load any @types packages (e.g. @types/node, which the benchmarks
    // use), so the library can't accidentally rely on Node.js APIs
    "types": [],

    "module": "NodeNext",
    "noEmit": true
  },
  "include": ["src"]
}
